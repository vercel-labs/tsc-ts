+
+/** Whether the checker logs prices (TSC_TS_SHARE_PRICE). */
+export const priceEnabled = pricePrefix !== '';
+
+/** The two kinds of shared result: the value type of a symbol, and the return type of a signature. */
+export const priceKindTypes = 0;
+export const priceKindReturns = 1;
+
+/** How a result was reached: computed for a file this checker took, computed for another checker's file, or taken. */
+export const priceOwned = 0;
+export const priceComputed = 1;
+export const priceTaken = 2;
+export const priceLocal = 3;
+
+/** The operators a shared evaluation cache would cover (section 10.3 of the design). */
+export const enum EvaluationKind {
+  /** The instantiation of a conditional type that its root has not resolved yet. */
+  Conditional,
+  /** The member of a distributive conditional type for one constituent of its check type. */
+  Distributed,
+  /** An indexed access on a generic or mapped object type, not resolved here yet. */
+  IndexedAccess,
+  /** `keyof` of a mapped type. */
+  KeyOfMapped,
+  /** A template literal type whose arguments are unions. */
+  Template,
+  /** A string mapping type over a union. */
+  MapOverUnion,
