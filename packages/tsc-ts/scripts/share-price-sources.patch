+/** Milliseconds with three decimals: a millionth of a second, for times up to an hour. */
+function fixed(ms: number): string {
+  return ms < 0 ? '-1' : ms.toFixed(3);
+}
+
+function hex(v: number): string {
+  return v.toString(16);
+}
+
+/** A computation record being filled in; the fields it does not set keep their defaults. */
+export class PriceEntry {
+  private readonly log: PriceLog;
+  private readonly at: number;
+
+  constructor(log: PriceLog, at: number) {
+    this.log = log;
+    this.at = at;
+  }
+
+  /** Sets how the computation was reached and why; `reason` is empty for most results. */
+  outcome(outcome: number, reason: string): void {
+    this.log.computations[this.at + computationOutcome] = outcome;
+    this.reason(reason);
+  }
+
+  /** Sets why the result was not posted or not taken, keeping how the computation was reached. */
+  reason(reason: string): void {
+    // A reason is one field of the log line, so its spaces are underscores.
+    this.log.computations[this.at + computationReason] =
+      reason === '' ? -1 : this.log.name(reason.replaceAll(' ', '_'));
+  }
+
+  /** The state word of the result's slot when this checker looked, and how the lookup ended. */
+  lookup(slot: number, outcome: number, reason: string): void {
+    this.log.computations[this.at + computationSlot] = slot;
+    this.outcome(outcome, reason);
+  }
+
+  /** Ends the computation: when it ended, whether it can be shared, and how many files its diagnostics are in. */
+  end(end: number, shareable: boolean, diagnosticFiles: number, typeCount: number, symbolId: number): void {
+    const c = this.log.computations;
+    c[this.at + computationEnd] = end;
+    c[this.at + computationShareable] = shareable ? 1 : 0;
+    c[this.at + computationDiagnosticFiles] = diagnosticFiles;
+    c[this.at + computationTypes] = typeCount - c[this.at + computationTypes]!;
+    c[this.at + computationSymbols] = symbolId - c[this.at + computationSymbols]!;
+  }
+
+  /** The dry run of the export this result would be posted with. */
+  export(records: number, words: number, units: number, ms: number): void {
+    const c = this.log.computations;
+    c[this.at + computationExportRecords] = records;
+    c[this.at + computationExportWords] = words;
+    c[this.at + computationExportUnits] = units;
+    c[this.at + computationExportMs] = ms;
+  }
+}
+
+/**
+ * What separates two evaluations a shared cache could match: the operator's node and the argument types, hashed by
+ * their structure, which every checker builds the same way. `0` for an argument this cannot see through.
+ */
+export function combineKey(hash: number, part: number): number {
+  // A 32-bit mix of `part` into `hash`.
+  let h = (hash ^ part) >>> 0;
+  h = Math.imul(h ^ (h >>> 16), 0x85ebca6b) >>> 0;
+  h = Math.imul(h ^ (h >>> 13), 0xc2b2ae35) >>> 0;
+  return (h ^ (h >>> 16)) >>> 0;
+}
