+          t[i + translationKind] +
+          ' ' +
+          t[i + translationProducer] +
+          ' ' +
+          fixed(t[i + translationStart]!) +
+          ' ' +
+          fixed(t[i + translationEnd]!) +
+          ' ' +
+          t[i + translationWalked] +
+          ' ' +
+          t[i + translationBuilt] +
+          ' ' +
