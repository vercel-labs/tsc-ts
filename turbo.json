{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "outputs": []
    },
    "build:oracle": {
      "outputs": ["dist/*-oracle", "dist/tsgo", "dist/typescript/**", "dist/oracle-build.json"],
      "inputs": ["oracles/**", "checkhost/**", "scripts/build-oracle.mjs", "$TURBO_ROOT$/upstream.json"]
    },
    "test": {
      "dependsOn": ["build", "build:oracle"],
      "cache": false
    },
    "tsc-ts#build": {
      "outputs": ["dist/**"]
    },
    "@tsc-ts/web#build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_SITE_URL", "VERCEL_PROJECT_PRODUCTION_URL", "VERCEL_ENV"]
    }
  }
}
